      - name: DB_CHECK_RETRIES
        value: "30"
      - name: DB_CHECK_INTERVAL
        value: "1"
      - name: DB_CHECK_TIMEOUT
        value: "5"
    image: mysql:latest
    name: wait-for-db
    resources: {}
should support use custom volume nfs:
  1: |
    - configMap:
        name: RELEASE-NAME-xwiki-init-scripts
      name: configmaps
    - name: secrets
      secret:
        secretName: RELEASE-NAME-xwiki-init-scripts
    - emptyDir:
        medium: Memory
        sizeLimit: 1Mi
      name: entrypoint
    - name: xwiki-data
      nfs:
        path: /volume
        readOnly: "false"
        server: server
